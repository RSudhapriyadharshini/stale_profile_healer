# Proxy credentials. Every request this prototype makes goes through this proxy —
# there is no direct-connection fallback. Leave PROXY_ENDPOINT blank and runs are
# refused rather than sent unproxied.
#
# Fill in your own values; .env is git-ignored so they never get committed.
# This is set up for Oxylabs' Web Scraper API "Proxy Endpoint":
# https://developers.oxylabs.io/products/web-scraper-api/integration-methods/proxy-endpoint

PROXY_USERNAME=
PROXY_PASSWORD=
PROXY_ENDPOINT=realtime.oxylabs.io:60000
# Scheme used to reach the proxy node itself. Oxylabs' own docs use https (curl -x https://...).
PROXY_SCHEME=https
# Oxylabs' documented requirement for the Proxy Endpoint ("ignore certificates" — curl's -k).
# Turns off TLS certificate verification for the connection to the proxy. Set to true only
# if you switch to a proxy provider that doesn't need this.
PROXY_VERIFY_TLS=false

# Optional Oxylabs job parameters, sent as x-oxylabs-* request headers. Leave blank to omit.
# https://developers.oxylabs.io/products/web-scraper-api/integration-methods/proxy-endpoint#accepted-parameters
PROXY_GEO_LOCATION=
PROXY_USER_AGENT_TYPE=
PROXY_RENDER=

# Liveness confirmation rule (see README > "Demoing suspect -> inactive").
# Production-realistic defaults: 2 checks, at least 3 days apart.
GONE_CONFIRMATIONS=2
GONE_MIN_DAYS=3
